; Self-contained fio examples for queue-depth and mixed-request experiments.
; Only the project-local disposable regular file is opened or written.
[global]
directory=./data/scratch
filename=fio-project3-disposable-file.bin
size=128m
ioengine=libaio
direct=1
allow_file_create=1
numjobs=1
thread=1
group_reporting=1
refill_buffers=1
buffer_compress_percentage=0
clat_percentiles=1
lat_percentiles=1
percentile_list=50:95:99:99.9
runtime=3
time_based=1

[preinitialize_file]
rw=write
bs=1m
iodepth=1
time_based=0

[qd1_randread]
stonewall=1
rw=randread
bs=4k
iodepth=1

[qd4_randread]
stonewall=1
rw=randread
bs=4k
iodepth=4

[qd16_randread]
stonewall=1
rw=randread
bs=4k
iodepth=16

[qd32_randread]
stonewall=1
rw=randread
bs=4k
iodepth=32

[read70_write30]
stonewall=1
rw=randrw
rwmixread=70
bs=4k
iodepth=8

[read50_write50]
stonewall=1
rw=randrw
rwmixread=50
bs=4k
iodepth=8
