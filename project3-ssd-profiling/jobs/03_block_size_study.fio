; Representative four-block-size request study with no raw-device target.
[global]
directory=./data/scratch
filename=fio-project3-disposable-file.bin
size=128m
ioengine=libaio
direct=1
allow_file_create=1
thread=1
numjobs=1
group_reporting=1
iodepth=4
refill_buffers=1
buffer_compress_percentage=0
clat_percentiles=1
lat_percentiles=1
percentile_list=50:95:99:99.9
runtime=3
time_based=1

[preinitialize_file]
rw=write
bs=1m
iodepth=1
time_based=0

[random_4k]
stonewall=1
rw=randread
bs=4k

[random_16k]
stonewall=1
rw=randread
bs=16k

[random_64k]
stonewall=1
rw=randread
bs=64k

[random_256k]
stonewall=1
rw=randread
bs=256k
