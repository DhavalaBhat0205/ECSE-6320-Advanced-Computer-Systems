; Dedicated project-local disposable file only. Run from repository root.
; This fully parameterized fio-3.x job file is provided as reproducible source;
; its execution is not part of the native-only measured dataset.
[global]
directory=./data/scratch
filename=fio-project3-disposable-file.bin
size=128m
ioengine=libaio
direct=1
allow_file_create=1
group_reporting=1
numjobs=1
iodepth=1
thread=1
refill_buffers=1
buffer_compress_percentage=0
clat_percentiles=1
lat_percentiles=1
percentile_list=50:95:99:99.9
randrepeat=0
runtime=3
time_based=1

[preinitialize_file]
rw=write
bs=1m
time_based=0

[random_read_4k]
stonewall=1
rw=randread
bs=4k

[random_write_4k]
stonewall=1
rw=randwrite
bs=4k

[sequential_read_128k]
stonewall=1
rw=read
bs=128k

[sequential_write_128k]
stonewall=1
rw=write
bs=128k
